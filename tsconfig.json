{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@fetch/*": ["./src/fetch/*"],
      "@render/*": ["./src/render/*"],
      "@post/*": ["./src/post/*"],
      "@config/*": ["./config/*"]
    }
  },
  "include": ["src/**/*", "remotion/**/*"]
}
